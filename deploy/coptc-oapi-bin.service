[Unit]
Description=CoptC cTrader DEMO BIN ayna (10s)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/CoptC
EnvironmentFile=/root/projects/CoptC/.env
ExecStart=/root/projects/CoptC/venv/bin/python /root/projects/CoptC/EylulForex/oapi_bin_paper.py --loop
Restart=always
RestartSec=3
StandardOutput=append:/tmp/oapi_bin_paper.log
StandardError=append:/tmp/oapi_bin_paper.log

[Install]
WantedBy=multi-user.target
