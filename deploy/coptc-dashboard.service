[Unit]
Description=CoptC Live Control dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/CEMAPI/CoptC
EnvironmentFile=/root/projects/CEMAPI/CoptC/.env
ExecStart=/root/projects/CEMAPI/CoptC/venv/bin/python /root/projects/CEMAPI/CoptC/web/dashboard.py
Restart=always
RestartSec=5
StandardOutput=append:/tmp/coptc_dashboard.log
StandardError=append:/tmp/coptc_dashboard.log

[Install]
WantedBy=multi-user.target
