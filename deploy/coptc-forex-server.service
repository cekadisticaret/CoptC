[Unit]
Description=CoptC Forex API (EylulForex)
After=network-online.target coptc-binance-ws.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/CEMAPI/CoptC
EnvironmentFile=/root/projects/CEMAPI/CoptC/.env
ExecStart=/root/projects/CEMAPI/CoptC/venv/bin/python /root/projects/CEMAPI/CoptC/EylulForex/forex_server.py
Restart=always
RestartSec=3
StandardOutput=append:/tmp/coptc_forex.log
StandardError=append:/tmp/coptc_forex.log

[Install]
WantedBy=multi-user.target
