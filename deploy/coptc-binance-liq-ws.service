[Unit]
Description=CoptC Binance USD-M liquidation websocket
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/CEMAPI/CoptC
EnvironmentFile=/root/projects/CEMAPI/CoptC/.env
ExecStart=/root/projects/CEMAPI/CoptC/venv/bin/python /root/projects/CEMAPI/CoptC/binance_liq_ws.py
Restart=always
RestartSec=3
StandardOutput=append:/tmp/coptc_binance_liq_ws.log
StandardError=append:/tmp/coptc_binance_liq_ws.log

[Install]
WantedBy=multi-user.target
